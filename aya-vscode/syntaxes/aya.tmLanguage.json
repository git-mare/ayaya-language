{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Aya",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#strings" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [{
        "name": "comment.line.double-slash.aya",
        "match": "//.*$"
      }]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.aya",
          "match": "\\b(omae|wa|wondering|show)\\b"
        },
        {
          "name": "constant.language.boolean.aya",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.aya",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aya",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.aya",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    }
  },
  "scopeName": "source.aya"
}