x = 10
y = 5

ur language = "AyaLang"
ur version = 1.5
ur is_active = legit

show(language + " is running: " + is_active)

wondering (x > y) {
    show("x > y: " + x)
}

// math mixing types (int and float)
ur calc = x * version
show("Result: " + calc)

// conditionals with truth values (truthy)
wondering (language) {
    show("String evaluates to legit!")
}
