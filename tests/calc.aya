// Defining the values and the desired operation
ur num1 = 15.5
ur num2 = 4
ur operation = "*"

ur result = 0

// Calculator logic
wondering (operation == "+") {
    result = num1 + num2
} actually (operation == "-") {
    result = num1 - num2
} actually (operation == "*") {
    result = num1 * num2
} actually (operation == "/") {
    // Prevent division by zero
    wondering (num2 != 0) {
        result = num1 / num2
    } nah {
        show("Error: Division by zero!")
    }
}

show("The calculation of " + num1 + " " + operation + " " + num2 + " is:")
show(result)
